{
  "name": "music",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F @music/backend --",
    "dev:setup": "turbo run dev:setup -F @music/backend --",
    "prepare": "effect-tsgo patch --typescript --oxlint && lefthook install",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "turbo run test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.3",
    "@music/config": "workspace:*",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "1.64.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.3.4"
}
