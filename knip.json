{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/**"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@effect/vitest", "effect"],
      "entry": [".agents/skills/*/scripts/*.mjs"]
    },
    "apps/web": {
      "entry": ["e2e-stack/first-audio.ts", "e2e/media-stand-in.ts"]
    },
    "apps/cli": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    },
    "packages/backend": {
      "entry": ["convex/*.ts", "scripts/*.ts", "test/*.test.ts"],
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    },
    "packages/ui": {},
    "packages/commands": {},
    "packages/sdk": {},
    "packages/player": {
      "entry": ["harness/*.{ts,tsx}", "browser/*.spec.ts"],
      "ignoreBinaries": ["ffmpeg", "ffprobe"]
    },
    "apps/media": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    }
  }
}
