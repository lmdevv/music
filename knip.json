{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "tools/oxlint/**"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@effect/vitest", "effect"]
    },
    "apps/web": {},
    "apps/cli": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    },
    "packages/backend": {
      "entry": ["convex/*.ts", "scripts/*.ts"],
      "typescript": {
        "config": ["convex/tsconfig.json"]
      }
    },
    "packages/ui": {},
    "packages/commands": {},
    "packages/sdk": {},
    "packages/player": {
      "entry": ["harness/*.{ts,tsx}", "browser/*.spec.ts"],
      "ignoreBinaries": ["ffmpeg", "ffprobe"]
    },
    "apps/media": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    }
  }
}
