{
  "extends": "@music/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@music/ui/*": ["../../packages/ui/src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "playwright.stack.config.ts",
    "e2e-stack"
  ]
}
