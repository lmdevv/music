#!/command/with-contenv bash
# First-boot and upgrade oneshot. Runs after the Convex backend starts and before the media
# service. Generates secrets into /data, backs up before an upgrade, deploys the bundled Convex
# functions, sets the deployment environment, and writes the media service env.
set -euo pipefail

data="${MUSIC_DATA:-/data}"
secrets="$data/secrets"
public="${PUBLIC_URL%/}"
version="$(node -p 'require("/app/backend/package.json").version')"
mkdir -p "$secrets" "$data/media" "$data/backups" /run/music

log() { echo "[init] $*"; }

random() { node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("base64url"))'; }

log "waiting for Convex"
for _ in $(seq 1 120); do
  curl -fsS http://127.0.0.1:3210/version >/dev/null 2>&1 && break
  sleep 1
done
curl -fsS http://127.0.0.1:3210/version >/dev/null

admin_key="$(/app/convex/generate_key music "$(cat "$secrets/instance_secret")" | tail -n 1)"
export CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
export CONVEX_SELF_HOSTED_ADMIN_KEY="$admin_key"
printf '%s\n' "$admin_key" > "$secrets/admin_key"
chmod 600 "$secrets/admin_key"

if [ ! -s "$secrets/media_secret" ]; then
  random > "$secrets/media_secret"
  chmod 600 "$secrets/media_secret"
fi

cd /app/backend
convex() { ./node_modules/.bin/convex "$@"; }

if [ -s "$data/version" ] && [ "$(cat "$data/version")" != "$version" ]; then
  backup="$data/backups/pre-$version-$(date +%Y%m%d%H%M%S).zip"
  log "upgrading from $(cat "$data/version") to $version; exporting to $backup"
  convex export --path "$backup"
fi

log "deploying functions"
convex deploy --yes --codegen disable --typecheck disable

log "configuring deployment"
# `--name=value` so a secret that starts with "-" is not read as an option.
node scripts/configure.ts "--site-url=$public" --media-url=/media \
  "--media-secret=$(cat "$secrets/media_secret")"

signing="$(convex env get STREAM_SIGNING_KEY)"
umask 077
cat > /run/music/media.env <<ENV
CONVEX_URL=http://127.0.0.1:3210
MEDIA_SERVICE_SECRET=$(cat "$secrets/media_secret")
STREAM_SIGNING_KEY=$signing
MEDIA_DATA_DIR=$data/media
PORT=4100
ENV

printf '%s\n' "$version" > "$data/version"
log "ready at $public"
