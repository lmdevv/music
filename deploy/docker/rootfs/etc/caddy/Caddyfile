{
	admin off
	auto_https off
	# One readable line per event in `docker logs`, like the other services, rather than JSON.
	log {
		format console {
			level_format upper
			time_local
		}
	}
	# Caddy aborts a response whose write stalls for `write_idle` (1m by default). Media elements
	# stop reading a stream once they have buffered far enough ahead, and while paused, so that
	# default cut songs off mid-way. The server-wide timeout is applied after the per-route
	# `timeouts` below and would override them, so it is off here and they set it per route.
	servers {
		timeouts {
			write_idle -1s
		}
	}
}

:8080 {
	encode zstd gzip

	# A media stream may sit unread for as long as a listener pauses; an hour bounds what a client
	# that never reads again can hold. Everything else keeps Caddy's default one-minute limit.
	@stream path /media/stream/*
	timeouts @stream {
		write_timeout 1h
	}
	@other not path /media/stream/*
	timeouts @other {
		write_timeout 1m
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# The media service's health check, which also queries Convex: 200 only while Caddy, the media
	# service, and Convex all answer, 502/503 otherwise. Monitors and the image's HEALTHCHECK use it.
	handle /healthz {
		rewrite * /media/health
		reverse_proxy 127.0.0.1:4100
	}

	handle_path /convex/* {
		reverse_proxy 127.0.0.1:3210
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:4100 {
			flush_interval -1
		}
	}

	handle {
		root * /app/web
		# Same-origin scripts only. Styles allow inline because components inject <style> tags.
		# The Convex client connects by WebSocket to /convex on this host.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ws://{hostport} wss://{hostport}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
