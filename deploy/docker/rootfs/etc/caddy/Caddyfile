{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle_path /convex/* {
		reverse_proxy 127.0.0.1:3210
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:4100 {
			flush_interval -1
		}
	}

	handle {
		root * /app/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
