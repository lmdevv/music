# Runtime configuration names. Never commit values.
# In the container and the NixOS module, the init oneshot generates these into /data on first boot.

# Self-hosted Convex
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
INSTANCE_SECRET=

# Shared between Convex and the media service
MEDIA_SERVICE_SECRET=
STREAM_SIGNING_KEY=

# Convex Auth
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=

# Public URL users open, behind the user's own reverse proxy or Tailscale
PUBLIC_URL=
